<file path="src/widgets/user-collections/ui/UserCollections.tsx">
"use client";

import { Button } from "@/shared/ui";
import { ChevronLeft, ChevronRight, Plus } from "lucide-react";
import { CreateFolderModal } from "@/widgets";
import { folders } from "../model/mock-folders";
import { Folder } from "./Folder";
import { Swiper, SwiperSlide } from "swiper/react";
import "swiper/css";
import { useRef, useState } from "react";
import type { Swiper as SwiperType } from "swiper";
import { Navigation } from "swiper/modules";
import { cn } from "@/shared/lib/utils";

interface UserCollectionsProps {
  setActiveFolder: (folder: number) => void;
  activeFolder: number;
}

export const UserCollections = ({ setActiveFolder, activeFolder }: UserCollectionsProps) => {
  const [isNavigationVisible, setIsNavigationVisible] = useState(false);
  const swiperRef = useRef<SwiperType | null>(null);

  const handleNext = () => {
    const swiper = swiperRef.current;
    swiper?.slideNext();
  };

  const handlePrev = () => {
    const swiper = swiperRef.current;
    swiper?.slidePrev();
  };

  return (
    <>
      <div className="flex items-center justify-between mb-5 pt-5">
        <h2 className="text-lg font-semibold text-foreground">Мои коллекции</h2>

        <CreateFolderModal>
          <Button variant="accent" size="sm" className="rounded-lg gap-2">
            <Plus className="size-4" />
            <span className="text-sm font-medium">Создать</span>
          </Button>
        </CreateFolderModal>
      </div>

      <div
        onMouseEnter={() => setIsNavigationVisible(true)}
        onMouseLeave={() => setIsNavigationVisible(false)}
      >
        <Swiper
          spaceBetween={10}
          modules={[Navigation]}
          loop={true}
          slidesPerView={5}
          slidesPerGroup={2}
          onSwiper={(swiper) => {
            swiperRef.current = swiper;
          }}
          className="relative min-h-[220px] h-full"
        >
          <Button
            onClick={handlePrev}
            variant="ghost"
            size="icon"
            className={cn(
              "absolute top-1/2 -translate-y-1/2 z-10 flex items-center justify-center",
              "size-10 rounded-full p-0",
              "bg-surface border border-border",
              "text-muted hover:text-foreground hover:border-accent/50 hover:bg-surface-elevated",
              "shadow-md transition-all duration-200",
              isNavigationVisible ? "opacity-100 left-1" : "opacity-0 -left-2 pointer-events-none",
            )}
          >
            <ChevronLeft className="size-5" />
          </Button>

          {folders.map((folder, index) => {
            const { id } = folder;

            return (
              <SwiperSlide key={id}>
                <Folder
                  folder={folder}
                  index={index}
                  activeFolder={activeFolder}
                  setActiveFolder={setActiveFolder}
                />
              </SwiperSlide>
            );
          })}

          <Button
            onClick={handleNext}
            variant="ghost"
            size="icon"
            className={cn(
              "absolute top-1/2 -translate-y-1/2 z-10 flex items-center justify-center",
              "size-10 rounded-full p-0",
              "bg-surface border border-border",
              "text-muted hover:text-foreground hover:border-accent/50 hover:bg-surface-elevated",
              "shadow-md transition-all duration-200",
              isNavigationVisible ? "opacity-100 right-1" : (
                "opacity-0 -right-2 pointer-events-none"
              ),
            )}
          >
            <ChevronRight className="size-5" />
          </Button>
        </Swiper>
      </div>
    </>
  );
};
</file>

<file path="src/features/flag-color-picker/ui/FlagColorPicker.tsx">
"use client";

import { Button, Label, Popover, PopoverContent, PopoverTrigger } from "@/shared/ui";
import { cn } from "@/shared/lib/utils";
import { useCreationFlagStore } from "@/features/creation-flag/model/creation-flag-store";
import { Pipette } from "lucide-react";
import { useShallow } from "zustand/shallow";
import { memo, useEffect, useState } from "react";
import ColorPicker from "react-best-gradient-color-picker";
import { useThrottle } from "@/shared/hooks";
import { OpacitySlider } from "@/features/opacity-slider";

export const FlagColorPicker = memo(() => {
  const { selectedColor, setSelectedColor, presetColors } = useCreationFlagStore(
    useShallow((state) => ({
      selectedColor: state.selectedColor,
      setSelectedColor: state.setSelectedColor,
      presetColors: state.presetColors,
      bgOpacity: state.bgOpacity,
      setBgOpacity: state.setBgOpacity,
    })),
  );

  const [tempColor, setTempColor] = useState(selectedColor);

  const throttledColor = useThrottle(tempColor, 50);

  useEffect(() => {
    setSelectedColor(throttledColor);
  }, [throttledColor]);

  return (
    <section className="rounded-xl border border-border/60 bg-surface-subtle p-4">
      <div className="flex items-center justify-between mb-4">
        <div className="flex items-center gap-2">
          <span className="w-0.5 h-4 rounded-full bg-accent shrink-0 shadow-[0_0_6px_rgba(155,86,240,0.8)]" />
          <Label className="text-sm font-semibold text-foreground">Цвет фона</Label>
        </div>

        <Popover>
          <PopoverTrigger asChild>
            <Button
              variant="ghost"
              className="flex items-center gap-2 h-8 px-2.5 rounded-lg border border-border/60 bg-surface hover:bg-surface-elevated transition-colors"
            >
              <span
                className="size-4 rounded-md border border-white/10 shrink-0"
                style={{ backgroundColor: selectedColor }}
              />
              <span className="text-xs text-zinc-muted font-mono truncate">{selectedColor}</span>
              <Pipette className="size-3.5 text-zinc-muted shrink-0" />
            </Button>
          </PopoverTrigger>

          <PopoverContent
            align="end"
            sideOffset={8}
            className="w-auto p-3 rounded-xl border border-border/60 bg-surface shadow-popover"
          >
            <div className="flex flex-col gap-3">
              <div className="flex items-center gap-2">
                <span className="w-0.5 h-3.5 rounded-full bg-accent shrink-0 shadow-[0_0_6px_rgba(155,86,240,0.8)]" />
                <span className="text-sm font-semibold text-foreground">Выбор цвета</span>
              </div>

              <ColorPicker
                value={tempColor}
                onChange={setTempColor}
                hideColorTypeBtns
                hideGradientControls
                hidePresets
                disableDarkMode
                width={260}
                height={160}
              />

              <div className="flex items-center justify-between pt-1 border-t border-border/40 gap-2">
                <span className="text-xs text-zinc-muted shrink-0">Выбранный цвет:</span>
                <div className="flex items-center gap-1.5 min-w-0">
                  <span
                    className="size-4 rounded border border-white/10 shrink-0"
                    style={{ backgroundColor: selectedColor }}
                  />
                  <span className="text-xs font-mono text-foreground truncate">
                    {selectedColor}
                  </span>
                </div>
              </div>
            </div>
          </PopoverContent>
        </Popover>
      </div>

      <div className="grid grid-cols-10 gap-1.5">
        {presetColors.map((color) => (
          <Button
            key={color}
            onClick={() => setSelectedColor(color)}
            title={color}
            className={cn(
              "size-8 rounded-lg border-2 transition-all cursor-pointer hover:scale-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring",
              selectedColor === color && "border-foreground ring-2 ring-foreground/20 scale-110",
              selectedColor !== color && "border-transparent hover:border-white/30",
            )}
            style={{ backgroundColor: color }}
          />
        ))}
      </div>

      <span className="text-base text-zinc-muted text-center w-full block">
        Тут будет много предопределенных цветов (на беке будем хранить)
      </span>

      <OpacitySlider />
    </section>
  );
});
</file>

