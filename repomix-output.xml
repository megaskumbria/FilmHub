"use client";
import { Form, FormControl, FormField, FormItem, FormMessage, Input } from "@/shared/ui";

import { useEffect } from "react";

import { zodResolver } from "@hookform/resolvers/zod";
import { useForm } from "react-hook-form";
import { collectionSchema, type CollectionSchema } from "../model/validation";

interface AddCollectionProps {
  onSuccess: () => void;
  addCollection: (name: string) => void;
}

export const AddCollection = ({ addCollection, onSuccess }: AddCollectionProps) => {
  const form = useForm<CollectionSchema>({
    resolver: zodResolver(collectionSchema),
    defaultValues: {
      name: "",
    },
  });

  const onSubmit = (data: CollectionSchema) => {
    addCollection(data.name);
    onSuccess();
  };

  useEffect(() => {
    form.setFocus("name");
  }, []);

  return (
    <Form {...form}>
      <form onSubmit={void form.handleSubmit(onSubmit)}>
        <FormField
          control={form.control}
          name="name"
          render={({ field }) => {
            return (
              <FormItem>
                <FormControl onBlur={onSuccess}>
                  <Input type="text" placeholder="Введите название папки..." {...field} />
                </FormControl>
                <FormMessage />
              </FormItem>
            );
          }}
        />
      </form>
    </Form>
  );
};
</file>

<file path="src/features/collection-manage/ui/RenameCollection.tsx">
"use client";
import type { Collection } from "@/entities/collection/model";
import { Form, FormControl, FormField, FormItem, FormMessage, Input } from "@/shared/ui";
import { zodResolver } from "@hookform/resolvers/zod";
import { useEffect, useRef } from "react";
import { useForm } from "react-hook-form";
import { collectionSchema, type CollectionSchema } from "../model/validation";

interface RenameCollectionProps {
  col: Collection;
  onSuccess: () => void;
  renameCollection: (col: Collection) => void;
}

export const RenameCollection = ({ col, onSuccess, renameCollection }: RenameCollectionProps) => {
  const inputRef = useRef<HTMLInputElement | null>(null);

  const form = useForm<CollectionSchema>({
    resolver: zodResolver(collectionSchema),
    defaultValues: {
      name: col.name,
    },
  });

  const onSubmit = ({ name }: CollectionSchema) => {
    renameCollection({ id: col.id, name });
    onSuccess();
  };

  useEffect(() => {
    inputRef.current?.focus();
    inputRef.current?.select();
  }, []);

  return (
    <Form {...form}>
      <form onSubmit={void form.handleSubmit(onSubmit)}>
        <FormField
          control={form.control}
          name="name"
          render={({ field }) => (
            <FormItem>
              <FormControl onBlur={onSuccess}>
                <Input
                  {...field}
                  type="text"
                  ref={(el) => {
                    field.ref(el); // RHF
                    inputRef.current = el; // свой ref
                  }}
                  placeholder="Введите название папки..."
                />
              </FormControl>
              <FormMessage />
            </FormItem>
          )}
        />
      </form>
    </Form>
  );
};
</file>

