<file path="src/widgets/add-flag-popover/ui/AddFlagPopover.tsx">
"use client";

import { useState } from "react";
import {
  Accordion,
  AccordionItem,
  AccordionTrigger,
  AccordionContent,
  Button,
  RadioGroupItem,
  RadioGroup,
  Tooltip,
  TooltipTrigger,
  TooltipContent,
  Input,
} from "@/shared/ui";
import { PopoverMode } from "@/widgets/movie-card/ui/MovieCard";
import { flagsData } from "@/shared/model/flags";
import { FlagBadge } from "@/entities/flag-badge/ui/FlagBadge";
import { HelpCircle, Plus, Search } from "lucide-react";
import { cn } from "@/shared/lib/utils";
import { IFlagItem } from "@/shared/model/flags";
import Link from "next/link";

interface AddFlagPopoverProps {
  mode: PopoverMode;
}

export const AddFlagPopover = ({ mode }: AddFlagPopoverProps) => {
  const [selectedFlags, setSelectedFlags] = useState<Record<string, IFlagItem>>({});

  const handleSelectFlag = (category: string, value: string, flagItems: IFlagItem[]) => {
    const flag = flagItems.find((flag) => flag.id.toString() === value);

    if (!flag) return;

    setSelectedFlags((prev) => ({
      ...prev,
      [category]: flag,
    }));
  };

  return (
    <>
      {mode === "add-flag" && (
        <div className="flex flex-col w-96">
          <header className="flex items-center justify-between px-3.5 py-3 border-b border-border/40 bg-linear-to-r from-accent/5 via-transparent to-transparent">
            <div className="flex items-center gap-2.5">
              <span className="w-0.5 h-4 rounded-full bg-accent shrink-0 shadow-[0_0_6px_rgba(155,86,240,0.8)]" />
              <span className="text-sm font-semibold text-foreground tracking-wide">Флаги</span>
            </div>

            <Tooltip>
              <TooltipTrigger asChild>
                <HelpCircle className="size-4 text-zinc-muted hover:text-foreground transition-colors cursor-pointer" />
              </TooltipTrigger>

              <TooltipContent>
                <p>Максимум 1 флаг из категории</p>
              </TooltipContent>
            </Tooltip>
          </header>

          <nav className="p-2.5">
            <div className="relative">
              <Search className="absolute left-2.5 top-1/2 -translate-y-1/2 size-3.5 text-zinc-muted pointer-events-none" />
              <Input
                variant="neutral"
                placeholder="Поиск категории..."
                className="pl-7 pr-2 text-sm h-9"
              />
              {/* {search && (
                <button
                  onClick={() => setSearch("")}
                  className="absolute right-2 top-1/2 -translate-y-1/2 text-zinc-muted hover:text-foreground transition-colors"
                >
                  <X className="size-3" />
                </button>
              )} */}
            </div>
          </nav>

          <div className="overflow-y-auto max-h-92 px-1.5 drawer-scroll">
            {flagsData.length === 0 ?
              <div className="py-6 text-center text-xs text-zinc-muted">Флаги не найдены</div>
            : <Accordion type="multiple">
                {flagsData.map(({ category, flagItems }) => {
                  return (
                    <AccordionItem
                      key={category}
                      value={category}
                      className="border-b border-border last:border-0"
                    >
                      <AccordionTrigger className="items-center px-2 py-2.5 text-sm font-medium text-foreground/70 hover:no-underline hover:bg-white/4 hover:text-foreground transition-all gap-2 data-[state=open]:text-foreground [&>svg]:text-zinc-muted/60 [&[data-state=open]>svg]:text-zinc-muted">
                        <span className="flex items-center gap-2 flex-1 min-w-0">
                          <span className="truncate">{category}</span>

                          {selectedFlags[category] && (
                            <span className="ml-auto mr-1 shrink-0">
                              <FlagBadge flagItem={selectedFlags[category]} />
                            </span>
                          )}
                        </span>
                      </AccordionTrigger>

                      <AccordionContent className="pb-1">
                        <RadioGroup
                          className="gap-0"
                          value={selectedFlags[category]?.id.toString()}
                          onValueChange={(value) => handleSelectFlag(category, value, flagItems)}
                        >
                          {flagItems.map((flag) => {
                            const isChecked = selectedFlags[category]?.id === flag.id;

                            return (
                              <label
                                key={flag.id}
                                className={cn(
                                  "flex items-center justify-between gap-2 px-2 py-1.5 rounded-lg cursor-pointer transition-all",
                                  "hover:bg-white/4",
                                  isChecked
                                    && "bg-accent/8 shadow-[inset_0_0_0_1px_rgba(155,86,240,0.25)]",
                                )}
                              >
                                <FlagBadge flagItem={flag} />
                                <RadioGroupItem
                                  value={flag.id.toString()}
                                  className={cn(
                                    "size-3.5 border shrink-0 transition-all",
                                    isChecked ?
                                      "border-accent bg-accent/20 text-accent shadow-[0_0_6px_rgba(155,86,240,0.4)]"
                                    : "border-border/50 text-accent",
                                  )}
                                />
                              </label>
                            );
                          })}
                        </RadioGroup>
                      </AccordionContent>
                    </AccordionItem>
                  );
                })}
              </Accordion>
            }
          </div>

          <footer className="px-2 py-2 border-t border-border/40 bg-linear-to-r from-accent/3 via-transparent to-transparent">
            <Link href="/creation-flag">
              <Button className="w-full h-8 text-zinc-muted hover:text-accent hover:bg-accent/10 transition-all px-2 gap-1.5 rounded-lg justify-start">
                <Plus className="size-3 shrink-0" />
                <span>Создать флаг</span>
              </Button>
            </Link>
          </footer>
        </div>
      )}
    </>
  );
};
</file>

<file path="src/widgets/collections-toolbar/ui/CollectionsToolbar.tsx">
"use client";

import { cn } from "@/shared/lib/utils";
import { Input, Button, Separator } from "@/shared/ui";
import { X, Clapperboard, Search, EyeOff, Eye, Share2, Heart } from "lucide-react";
import { useEffect, useRef, useState } from "react";
import { FilterPopover, CollectionComments } from "@/widgets";
import { AddMovieModal } from "@/widgets/add-movie-modal";
import { folders } from "@/widgets/user-collections/model/mock-folders";

interface CollectionsToolbarProps {
  activeFolder: number;
}

export const CollectionsToolbar = ({ activeFolder }: CollectionsToolbarProps) => {
  const [isSearchOpen, setIsSearchOpen] = useState(false);
  const [searchQuery, setSearchQuery] = useState("");
  const [isCollectionVisible, setIsCollectionVisible] = useState(true);

  const focusRef = useRef<HTMLInputElement>(null);

  const currentFolder = folders[activeFolder];
  const { iconColor, name, count, icon: Icon, liked, shared } = currentFolder;

  useEffect(() => {
    if (isSearchOpen) {
      setTimeout(() => focusRef.current?.focus(), 150);
    }
  }, [isSearchOpen]);

  const handleOpenInput = () => {
    setIsSearchOpen((prev) => !prev);
    if (isSearchOpen) setSearchQuery("");
  };

  return (
    <div className="flex items-center justify-between mb-5 pt-5">
      <div className="flex items-center gap-2 pr-2">
        {currentFolder && (
          <div className={cn("shrink-0", iconColor)}>
            <Icon className="size-5" />
          </div>
        )}

        <h2 className={cn("text-lg font-bold", iconColor)}>{name}</h2>

        <Separator orientation="vertical" className="h-5 bg-border" />

        <span className="text-base font-normal text-foreground">{count}</span>

        <Separator orientation="vertical" className="h-5 bg-border" />

        <div className="flex items-center gap-1.5">
          <Button className="flex items-center gap-1.5 h-8 px-1 rounded-lg text-zinc-muted hover:text-foreground hover:bg-white/5 transition-colors duration-200">
            <Share2 className="size-3.5 shrink-0" />
            <span className="text-sm tabular-nums">{shared}</span>
          </Button>

          <Button className="flex items-center gap-1.5 h-8 px-1 rounded-lg text-zinc-muted hover:text-rose-400 hover:bg-rose-400/5 transition-colors duration-200">
            <Heart className="size-3.5 shrink-0" />
            <span className="text-sm tabular-nums">{liked}</span>
          </Button>
        </div>
      </div>

      <div className="flex items-center gap-2">
        <div className="flex items-center gap-2">
          <div
            className={cn(
              "flex items-center gap-2 overflow-hidden transition-all duration-300 ease-in-out",
              isSearchOpen ? "w-52" : "w-0",
            )}
          >
            <Input
              ref={focusRef}
              value={searchQuery}
              variant="neutral"
              onChange={(e) => setSearchQuery(e.target.value)}
              placeholder="Поиск по коллекции..."
              className="h-9 text-sm rounded-lg border-border bg-surface placeholder:text-zinc-muted"
            />
          </div>

          <Button
            onClick={handleOpenInput}
            className={cn(
              "rounded-lg size-9 p-0 flex items-center justify-center border transition-colors duration-200",
              isSearchOpen ?
                "bg-accent/10 border-accent/30 text-accent"
              : "bg-transparent border-border text-zinc-muted hover:text-foreground hover:border-zinc-muted",
            )}
          >
            {isSearchOpen ?
              <X className="size-4" />
            : <Search className="size-4" />}
          </Button>
        </div>

        <FilterPopover />

        <Separator orientation="vertical" className="h-5 bg-border" />

        <AddMovieModal>
          <Button
            size="sm"
            className="transition-colors duration-200 h-9 shrink-0 whitespace-nowrap rounded-lg gap-2 bg-transparent border border-border text-zinc-muted hover:text-foreground hover:border-zinc-muted"
          >
            <Clapperboard className="size-4 shrink-0" />
            <span className="text-sm">Добавить фильм вручную</span>
          </Button>
        </AddMovieModal>

        <Button
          size="sm"
          onClick={() => setIsCollectionVisible((prev) => !prev)}
          className={cn(
            "rounded-lg h-9 p-0 border transition-colors duration-200",
            isCollectionVisible ?
              "bg-transparent border-border text-zinc-muted hover:text-foreground hover:border-zinc-muted"
            : "bg-success/10 border-success/30 text-success",
          )}
        >
          {isCollectionVisible ?
            <EyeOff className="shrink-0 size-4" />
          : <Eye className="shrink-0 size-4" />}
        </Button>

        <Separator orientation="vertical" className="h-5 bg-border" />

        <CollectionComments />
      </div>
    </div>
  );
};
</file>

