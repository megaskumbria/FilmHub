  "about": {
    "version": "Version {version}",
    "title": "About the project",
    "lead": "FilmHub is a place where you collect movies into collections, share them with friends, and browse what other people have put together. It also lets you describe a film in a way no review can: with flags.",
    "collections": {
      "title": "Collections",
      "text": "Put movies into collections, show them to your friends, and see what others are collecting. Adding a movie is quick and convenient, so you don't have to jump between tabs every time."
    },
    "flags": {
      "title": "Flags are FilmHub's signature feature",
      "steps": {
        "what": "What it is",
        "how": "How it works",
        "result": "What you get"
      },
      "poster": "Your movie",
      "what": "A flag is a way to express how you feel about a movie and the state it leaves you in. It paints the film in your own tone and gives it character.",
      "how": "Instead of writing a review, you use a single flag to show how excessive the movie felt to you.",
      "result": "Other users read your impression at a glance: this one has a lot of blood, and that one has a brilliant ending.",
      "examples": {
        "gore": "Lots of blood",
        "finale": "Brilliant ending",
        "twist": "Unexpected twist",
        "cozy": "Cozy evening"
      }
    },
    "cards": {
